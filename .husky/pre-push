#!/usr/bin/env bash
# pre-push: L2 (test:e2e, gate:routes strict) + G2 (gate:security).
# Matches docs/08-6dq-improvement.md §4 canonical layout. e2e tests run
# before route coverage so the strict gate operates on a fresh hit ledger;
# security gate runs last and gates the actual push.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=../scripts/ensure-tools.sh
source "$HOOK_DIR/../scripts/ensure-tools.sh"
require_tool osv-scanner "dependency CVE scan"
require_tool gitleaks "secrets scanning"

echo "🐓 rooster pre-push — L2 + G2"
bun run test:e2e
bun run gate:routes
bun run gate:security
