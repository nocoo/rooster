{
  "name": "rooster",
  "private": true,
  "workspaces": ["packages/*"],
  "trustedDependencies": ["better-sqlite3"],
  "scripts": {
    "dev": "bun run --filter ./packages/server dev",
    "build": "bun run --filter '*' build",
    "pretest": "node -e \"require('./packages/server/node_modules/better-sqlite3')\" || (cd packages/server/node_modules/better-sqlite3 && npx --yes prebuild-install || npx --yes node-gyp rebuild --release)",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p packages/server --noEmit && tsc -p packages/client --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --max-warnings 0"]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.5",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
